# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The service role key is used only in Server Actions (never sent to the
# browser). Do not prefix these with NEXT_PUBLIC_.

# Public address of the deployed app. RSVP links sent to guests use this, so set
# it to your live URL (e.g. https://hitched.vercel.app). Falls back to the
# address you're browsing from, which is no use to guests when it's localhost.
NEXT_PUBLIC_SITE_URL=
# Country code assumed for phone numbers written without one (44 = UK, 233 = Ghana).
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=44

# Planner login. Everything except the guest RSVP pages needs this password.
# Without ADMIN_PASSWORD nobody can sign in, so the planner stays locked.
ADMIN_PASSWORD=
# Signs the login cookie. Any long random string; change it to sign everyone out.
SESSION_SECRET=
# Your main wedding website, linked from every guest page and the invitation.
NEXT_PUBLIC_WEDDING_SITE_URL=https://withjoy.com/vanessa-and-hope
