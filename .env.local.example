# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The service role key is used only in Server Actions (never sent to the
# browser). Do not prefix these with NEXT_PUBLIC_.

# Only needed if you are NOT using www.vanessahopehitched.uk / planner.vanessahopehitched.uk.
# On those two addresses, RSVP links always use www.vanessahopehitched.uk. Elsewhere this is the
# public address RSVP links use (falls back to the address you're browsing from, no use if localhost).
NEXT_PUBLIC_SITE_URL=
# The two addresses (src/lib/hosts.ts). Leave these blank to use the defaults.
NEXT_PUBLIC_PUBLIC_HOST=www.vanessahopehitched.uk
NEXT_PUBLIC_PLANNER_HOST=planner.vanessahopehitched.uk
# Country code assumed for phone numbers written without one (44 = UK, 233 = Ghana).
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=44

# Planner login. Everything except the guest RSVP pages needs this password.
# Without ADMIN_PASSWORD nobody can sign in, so the planner stays locked.
ADMIN_PASSWORD=
# Signs the login cookie. Any long random string; change it to sign everyone out.
SESSION_SECRET=
# Your main wedding website, linked from the RSVP page and the invitation message.
# (defaults to https://www.vanessahopehitched.uk)
NEXT_PUBLIC_WEDDING_SITE_URL=

# Google Maps JavaScript API key for the Places to Stay map. Optional: without it the page uses an OpenStreetMap map.
# Restrict the key to your website addresses (HTTP referrers) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
